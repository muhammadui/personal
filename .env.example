# Local development. Copy what you need; never commit real values.
# Worker secrets for `wrangler dev` live in apps/api/.dev.vars (see apps/api/.dev.vars.example).

# Postgres (docker compose up -d db)
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:54329/personal
APP_DB_PASSWORD=personal_app

# Tests use a throwaway database created from this admin URL
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres

# Sending real email from scripts (optional)
RESEND_API_KEY=
